# Magnum example "Cube Map" (https://magnum.graphics/doc/magnum/examples-cubemap.html), reproduced headless: the original renders a skybox cube map and an object reflecting it. Here a six-sided room (each face its own colour, the cube-map faces) surrounds three glossy spheres; the reflection itself needs an environment lookup the rasterizers lack.
out = ARGV.len() > 0 ? ARGV[0] : "build/cubemap.dslb";
mkdir("images");
mkdir("build");
p = _lmcode_ cli="lmfilament" install="github:lmctl-ai/lmfilament@latest";
let mat = fil.material("aiDefaultMat", "material {\n    name : AssimpDefaultMat,\n    shadingModel : lit,\n    parameters : [\n        {\n            type : float3,\n            name : baseColor\n        },\n        {\n            type : float,\n            name : metallic\n        },\n        {\n            type : float,\n            name : roughness\n        },\n        {\n            type : float,\n            name : reflectance\n        }\n    ],\n}\n\nfragment {\n    void material(inout MaterialInputs material) {\n        prepareMaterial(material);\n        material.baseColor.rgb = materialParams.baseColor;\n        material.metallic = materialParams.metallic;\n        material.roughness = materialParams.roughness;\n        material.reflectance = materialParams.reflectance;\n    }\n}\n");
mat.set_float("metallic", 1.0);
mat.set_float("roughness", 0.1);
let s = fil.scene();
s.skybox(0.0, 0.0, 0.0);
mat.set_float3("baseColor", 0.85, 0.25, 0.22);
s.add_at(fil.box(0.2, 20.0, 20.0), mat, 10.0, 0.0, 0.0);
mat.set_float3("baseColor", 0.25, 0.7, 0.35);
s.add_at(fil.box(0.2, 20.0, 20.0), mat, -10.0, 0.0, 0.0);
mat.set_float3("baseColor", 0.8, 0.85, 0.95);
s.add_at(fil.box(20.0, 0.2, 20.0), mat, 0.0, 10.0, 0.0);
mat.set_float3("baseColor", 0.3, 0.3, 0.34);
s.add_at(fil.box(20.0, 0.2, 20.0), mat, 0.0, -10.0, 0.0);
mat.set_float3("baseColor", 0.92, 0.8, 0.25);
s.add_at(fil.box(20.0, 20.0, 0.2), mat, 0.0, 0.0, -10.0);
mat.set_float3("baseColor", 0.25, 0.4, 0.85);
s.add_at(fil.box(20.0, 20.0, 0.2), mat, 0.0, 0.0, 10.0);
mat.set_float3("baseColor", 0.9, 0.9, 0.92);
s.add_at(fil.sphere(1.6, 48), mat, 0.0, 0.0, 0.0);
s.add_at(fil.sphere(0.9, 32), mat, -3.5, -1.0, -2.0);
s.add_at(fil.sphere(0.9, 32), mat, 3.5, -1.0, -2.0);
s.directional_light(1.0, 1.0, 1.0, 60000.0, -0.2, -0.7, -0.6);
s.camera(60.0, 0.0, 0.5, 8.5, 0.0, 0.0, 0.0);
s.render_frames(1);
s.render_png("images/cubemap.png", 800, 600);
end _lmcode_
savedsl(p, out);
r = system(concat(dsl_cli(p), ["--dsl", out]), 900000);
if (r.code != 0) { println(r.stderr + r.stdout); }
assert(r.code == 0);
println("ok cubemap");
