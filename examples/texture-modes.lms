# Texture filtering and wrapping (lmfilament)
# One 8x8 pixel-art texture on quads: the top row magnifies it with linear (smooth) and nearest (crisp) filtering, then shows a checker at a grazing angle (trilinear mips); the bottom row repeats the UVs 2.5 times with wrap "repeat", "clamp" (edge pixels stretch) and "mirror". Textures are uploaded to Filament (noop backend) as sampler2d parameters; the picture comes from lmfilament's CPU preview rasterizer.
# Run anywhere: lmctl autorun https://raw.githubusercontent.com/lmctl-ai/lmfilament/main/examples/texture-modes.lms
out = ARGV.len() > 0 ? ARGV[0] : "build/texture-modes.dslb";
mkdir("images");
mkdir("build");
p = _lmcode_ cli="lmfilament" install="github:lmctl-ai/lmfilament@latest";
let flat = fil.material("texUnlit", "material {\n    name : TexUnlit,\n    shadingModel : unlit,\n    requires : [\n        uv0\n    ],\n    parameters : [\n        {\n            type : sampler2d,\n            name : albedo\n        }\n    ],\n}\n\nfragment {\n    void material(inout MaterialInputs material) {\n        prepareMaterial(material);\n        material.baseColor.rgb = texture(materialParams_albedo, getUV0()).rgb;\n    }\n}\n");
let lin = fil.texture(8, 8);
let nea = fil.texture(8, 8);
let rep = fil.texture(8, 8);
let clp = fil.texture(8, 8);
let mir = fil.texture(8, 8);
for (y in range(0, 8)) {
  for (x in range(0, 8)) {
    let d = abs(float(x) - 3.5) + abs(float(y) - 3.5);
    let on = 0.0;
    if ((x + y) % 2 == 0) { on = 1.0; }
    let r = 0.15 + 0.2 * on;
    let g = 0.25 + 0.2 * on;
    let b = 0.55;
    if (d < 4.1) { r = 0.95; g = 0.75; b = 0.2; }
    if (x == 0) { if (y == 0) { r = 0.9; g = 0.2; b = 0.25; } }
    lin.pixel(x, y, r, g, b);
    nea.pixel(x, y, r, g, b);
    rep.pixel(x, y, r, g, b);
    clp.pixel(x, y, r, g, b);
    mir.pixel(x, y, r, g, b);
  }
}
lin.filter("linear");
nea.filter("nearest");
rep.filter("nearest").wrap("repeat").repeat(2.5, 2.5);
clp.filter("nearest").wrap("clamp").repeat(2.5, 2.5);
mir.filter("nearest").wrap("mirror").repeat(2.5, 2.5);
# a large checker seen at a grazing angle: mip levels keep the distance clean instead of shimmering
let far = fil.texture_checker(256, 32, 0.9, 0.9, 0.85, 0.2, 0.25, 0.4).repeat(3.0, 3.0);
let s = fil.scene();
s.skybox(0.01, 0.012, 0.02);
flat.set_texture("albedo", lin);
s.add_part(fil.plane(1.8, 1.8), flat).rotate(90.0, 0.0, 0.0).translate(-2.1, 1.1, 0.0);
flat.set_texture("albedo", nea);
s.add_part(fil.plane(1.8, 1.8), flat).rotate(90.0, 0.0, 0.0).translate(0.0, 1.1, 0.0);
flat.set_texture("albedo", far);
s.add_part(fil.plane(2.2, 2.2), flat).rotate(30.0, 0.0, 0.0).translate(2.1, 1.0, 0.0);
flat.set_texture("albedo", rep);
s.add_part(fil.plane(1.8, 1.8), flat).rotate(90.0, 0.0, 0.0).translate(-2.1, -1.1, 0.0);
flat.set_texture("albedo", clp);
s.add_part(fil.plane(1.8, 1.8), flat).rotate(90.0, 0.0, 0.0).translate(0.0, -1.1, 0.0);
flat.set_texture("albedo", mir);
s.add_part(fil.plane(1.8, 1.8), flat).rotate(90.0, 0.0, 0.0).translate(2.1, -1.1, 0.0);
s.camera(40.0, 0.0, 0.0, 9.0, 0.0, 0.0, 0.0);
s.render_frames(1);
s.render_png("images/texture-modes.png", 640, 400);
end _lmcode_
savedsl(p, out);
r = system(concat(dsl_cli(p), ["--lmcode", out]), 900000);
if (r.code != 0) { println(r.stderr + r.stdout); }
assert(r.code == 0);
println("ok texture-modes");
