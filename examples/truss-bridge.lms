# Pratt truss footbridge: method of joints, solved in closed form. Span 24 m in six 4 m panels, depth 4 m, 100 kN on each of the
# five deck joints. Support reactions R = 250 kN; the middle top chord carries -450 kN (compression) and the centre vertical nothing.
# Red members are in tension, blue in compression, grey carry zero; tube radius grows with |F|.
# Ported from lmcad examples/truss-bridge.lms (only the 3D part; the lmplot elevation is left out).
out = ARGV.len() > 0 ? ARGV[0] : "build/truss-bridge.dslb";
mkdir("images");
mkdir("build");
p = _dsl_ cli="lmfilament" install="github:lmctl-ai/lmfilament@latest";
let mat = fil.material("aiDefaultMat", "material {\n    name : AssimpDefaultMat,\n    shadingModel : lit,\n    parameters : [\n        {\n            type : float3,\n            name : baseColor\n        },\n        {\n            type : float,\n            name : metallic\n        },\n        {\n            type : float,\n            name : roughness\n        },\n        {\n            type : float,\n            name : reflectance\n        }\n    ],\n}\n\nfragment {\n    void material(inout MaterialInputs material) {\n        prepareMaterial(material);\n        material.baseColor.rgb = materialParams.baseColor;\n        material.metallic = materialParams.metallic;\n        material.roughness = materialParams.roughness;\n        material.reflectance = materialParams.reflectance;\n    }\n}\n");
mat.set_float("metallic", 0.2);
mat.set_float("roughness", 0.45);
let scn = fil.scene();
scn.skybox(1.0, 1.0, 1.0);
let n = 6;
let d = 4.0;
let h = 4.0;
let load = 100.0;
let reaction = float(n - 1) * load / 2.0;
let diag = sqrt(d * d + h * h);
let sin_t = h / diag;
let fmax = 450.0;

for (side in range(0, 2)) {
  let z = -2.6 + 5.2 * float(side);
  for (i in range(0, n + 1)) {
    mat.set_float3("baseColor", 0.30, 0.33, 0.38);
    scn.add_at(fil.sphere(0.30, 24), mat, float(i) * d, 0.0, z);
    if (i > 0) {
      if (i < n) { mat.set_float3("baseColor", 0.30, 0.33, 0.38);
      scn.add_at(fil.sphere(0.30, 24), mat, float(i) * d, h, z); }
    }
  }
  for (k in range(0, n)) {
    let kk = k;
    if (k >= n / 2) { kk = n - 1 - k; }
    let j = max(kk, 1);
    let m = reaction * float(j) * d - load * d * float(j * (j - 1)) / 2.0;
    let f = m / h;
    let t = abs(f) / fmax;
    mat.set_float3("baseColor", lerp(0.62, 0.86, t), lerp(0.62, 0.18, t), lerp(0.64, 0.14, t));
    scn.add(fil.tube_between(float(k) * d, 0.0, z, float(k + 1) * d, 0.0, z, 0.10 + 0.16 * t), mat);
  }
  for (k in range(1, n - 1)) {
    let kk = k;
    if (k >= n / 2) { kk = n - 1 - k; }
    let j = kk + 1;
    let m = reaction * float(j) * d - load * d * float(j * (j - 1)) / 2.0;
    let f = 0.0 - m / h;
    let t = abs(f) / fmax;
    mat.set_float3("baseColor", lerp(0.62, 0.14, t), lerp(0.62, 0.36, t), lerp(0.64, 0.86, t));
    scn.add(fil.tube_between(float(k) * d, h, z, float(k + 1) * d, h, z, 0.10 + 0.16 * t), mat);
  }
  let fe = reaction / sin_t;
  let te = fe / fmax;
  mat.set_float3("baseColor", lerp(0.62, 0.14, te), lerp(0.62, 0.36, te), lerp(0.64, 0.86, te));
    scn.add(fil.tube_between(0.0, 0.0, z, d, h, z, 0.10 + 0.16 * te), mat);
  mat.set_float3("baseColor", lerp(0.62, 0.14, te), lerp(0.62, 0.36, te), lerp(0.64, 0.86, te));
    scn.add(fil.tube_between(float(n) * d, 0.0, z, float(n - 1) * d, h, z, 0.10 + 0.16 * te), mat);
  for (k in range(1, n / 2)) {
    let f = (reaction - float(k) * load) / sin_t;
    let t = f / fmax;
    mat.set_float3("baseColor", lerp(0.62, 0.86, t), lerp(0.62, 0.18, t), lerp(0.64, 0.14, t));
    scn.add(fil.tube_between(float(k) * d, h, z, float(k + 1) * d, 0.0, z, 0.10 + 0.16 * t), mat);
    mat.set_float3("baseColor", lerp(0.62, 0.86, t), lerp(0.62, 0.18, t), lerp(0.64, 0.14, t));
    scn.add(fil.tube_between(float(n - k) * d, h, z, float(n - k - 1) * d, 0.0, z, 0.10 + 0.16 * t), mat);
  }
  for (i in range(1, n)) {
    let ii = i;
    if (i > n / 2) { ii = n - i; }
    let f = 0.0;
    if (ii == 1) { f = load; }
    if (ii > 1) {
      if (ii < n / 2) { f = 0.0 - (reaction - float(ii) * load); }
    }
    let t = abs(f) / fmax;
    let cr = 0.62; let cg = 0.62; let cb = 0.64;
    if (f > 0.0) { cr = lerp(0.62, 0.86, t); cg = lerp(0.62, 0.18, t); cb = lerp(0.64, 0.14, t); }
    if (f < 0.0) { cr = lerp(0.62, 0.14, t); cg = lerp(0.62, 0.36, t); cb = lerp(0.64, 0.86, t); }
    mat.set_float3("baseColor", cr, cg, cb);
    scn.add(fil.tube_between(float(i) * d, 0.0, z, float(i) * d, h, z, 0.10 + 0.16 * t), mat);
  }
}
for (i in range(0, n + 1)) {
  mat.set_float3("baseColor", 0.30, 0.33, 0.38);
    scn.add(fil.tube_between(float(i) * d, -0.05, -2.6, float(i) * d, -0.05, 2.6, 0.12), mat);
  if (i > 0) {
    if (i < n) {
      mat.set_float3("baseColor", 0.30, 0.33, 0.38);
    scn.add(fil.tube_between(float(i) * d, h, -2.6, float(i) * d, h, 2.6, 0.09), mat);
    }
  }
}
mat.set_float3("baseColor", 0.74, 0.72, 0.68);
scn.add_at(fil.box(float(n) * d + 1.2, 0.22, 4.6), mat, float(n) * d / 2.0, -0.30, 0.0);
scn.directional_light(1.0, 1.0, 1.0, 110000.0, -0.35, -0.85, -0.45);
scn.camera(28.0, 1.0, 9.5, 27.0, 12.0, 1.3, 0.0);
scn.render_frames(2);
scn.render_png("images/truss-bridge.png", 900, 400);
end _dsl_
savedsl(p, out);
r = system(concat(dsl_cli(p), ["--dsl", out]), 900000);
if (r.code != 0) { println(r.stderr + r.stdout); }
assert(r.code == 0);
println("ok truss-bridge");
