# Magnum example "Bullet Physics" (https://magnum.graphics/doc/magnum/examples-bullet.html), reproduced headless as ballistics: 64 boxes released at staggered heights, each following its own closed-form free fall with inelastic bounces (restitution 0.5) and a spin that stops after landing. There is no rigid-body engine here, so boxes do not collide; the grid keeps them apart on the floor.
out = ARGV.len() > 0 ? ARGV[0] : "build/bullet.dslb";
mkdir("images");
mkdir("build");
p = _lmcode_ cli="lmfilament" install="github:lmctl-ai/lmfilament@latest";
let mat = fil.material("aiDefaultMat", "material {\n    name : AssimpDefaultMat,\n    shadingModel : lit,\n    parameters : [\n        {\n            type : float3,\n            name : baseColor\n        },\n        {\n            type : float,\n            name : metallic\n        },\n        {\n            type : float,\n            name : roughness\n        },\n        {\n            type : float,\n            name : reflectance\n        }\n    ],\n}\n\nfragment {\n    void material(inout MaterialInputs material) {\n        prepareMaterial(material);\n        material.baseColor.rgb = materialParams.baseColor;\n        material.metallic = materialParams.metallic;\n        material.roughness = materialParams.roughness;\n        material.reflectance = materialParams.reflectance;\n    }\n}\n");
mat.set_float("metallic", 0.0);
mat.set_float("roughness", 0.6);
let s = fil.scene();
s.skybox(0.55, 0.7, 0.9);
mat.set_float3("baseColor", 0.35, 0.37, 0.4);
s.add_at(fil.box(14.0, 0.2, 14.0), mat, 0.0, -0.1, 0.0);
let g = 9.81;
let e = 0.5;
let seed = 4242;
for (i in range(0, 64)) {
  seed = (seed * 1103515245 + 12345) - ((seed * 1103515245 + 12345) / 2147483648) * 2147483648;
  let u1 = float(seed) / 2147483648.0;
  seed = (seed * 1103515245 + 12345) - ((seed * 1103515245 + 12345) / 2147483648) * 2147483648;
  let u2 = float(seed) / 2147483648.0;
  seed = (seed * 1103515245 + 12345) - ((seed * 1103515245 + 12345) / 2147483648) * 2147483648;
  let u3 = float(seed) / 2147483648.0;
  let gx = i - (i / 8) * 8;
  let gz = i / 8;
  let x = (float(gx) - 3.5) * 1.25 + (u1 - 0.5) * 0.3;
  let z = (float(gz) - 3.5) * 1.25 + (u2 - 0.5) * 0.3;
  let size = 0.5 + 0.25 * u3;
  let h = 2.0 + 6.0 * u1;
  let tau = 1.2 - 0.5 * u2;
  let tf = sqrt(2.0 * h / g);
  let y = h - 0.5 * g * tau * tau;
  let spin = (u3 - 0.5) * 540.0;
  let t_spin = tau;
  if (tau > tf) {
    let v = e * g * tf;
    let rem = tau - tf;
    y = 0.0;
    let airborne = 1;
    for (k in range(0, 6)) {
      let flight = 2.0 * v / g;
      if (airborne == 1) {
        if (rem > flight) { rem = rem - flight; v = v * e; }
        else { y = v * rem - 0.5 * g * rem * rem; airborne = 0; }
      }
    }
    t_spin = tf + 0.25;
  }
  let ay = spin * t_spin;
  let ax = spin * 0.6 * t_spin;
  y = y + size * 0.5;
  let cr = 0.45 + 0.5 * u1;
  let cg = 0.45 + 0.5 * u2;
  let cb = 0.45 + 0.5 * u3;
  mat.set_float3("baseColor", cr, cg, cb);
  s.add_part(fil.box(size, size, size), mat).translate(x, y, z).rotate(ax, ay, 0.0);
}
s.shadows(true);
s.directional_light(1.0, 1.0, 1.0, 110000.0, -0.4, -0.9, -0.5);
s.camera(38.0, 0.0, 7.5, 12.0, 0.0, 2.0, 0.0);
s.render_frames(1);
s.render_png("images/bullet.png", 900, 600);
end _lmcode_
savedsl(p, out);
r = system(concat(dsl_cli(p), ["--lmcode", out]), 900000);
if (r.code != 0) { println(r.stderr + r.stdout); }
assert(r.code == 0);
println("ok bullet");
