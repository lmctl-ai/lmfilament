# lmfilament port of upstream samples/material_sandbox.cpp
# Compiles every sandbox*.mat variant (lit, cloth, subsurface, refraction, ...) and previews each on a sphere.
# Run anywhere: lmctl autorun https://raw.githubusercontent.com/lmctl-ai/lmfilament/main/examples/material_sandbox.lms
# Filament runs on its noop backend; the picture comes from lmfilament's CPU preview rasterizer (images/material_sandbox.png).
out = ARGV.len() > 0 ? ARGV[0] : "build/material_sandbox.dslb";
mkdir("build");
mkdir("build/materials");
mkdir("images");
p = _lmcode_ cli="lmfilament" install="github:lmctl-ai/lmfilament@latest";
let s = fil.scene();
s.directional_light(1.0, 1.0, 1.0, 100000.0, 0.7, -1.0, -0.8);
s.camera(45.0, 0.0, 0.0, 12.0, 0.0, 0.0, 0.0);
s.add_at(fil.sphere(0.5, 24), fil.material("sandboxLit", "material {\n    name : LitOpaque,\n    shadingModel : lit,\n    apiLevel : 2,\n    parameters : [\n        {\n            type : float3,\n            name : baseColor\n        },\n        {\n            type : float,\n            name : roughness\n        },\n        {\n            type : float,\n            name : metallic\n        },\n        {\n            type : float,\n            name : reflectance\n        },\n        {\n            type : float,\n            name : secondRoughness\n        },\n        {\n            type : float,\n            name : secondRoughnessWeight\n        },\n        {\n            type : float3,\n            name : sheenColor\n        },\n        {\n            type : float,\n            name : sheenRoughness\n        },\n        {\n            type : float,\n            name : iridescence\n        },\n        {\n            type : float,\n            name : iridescenceIor\n        },\n        {\n            type : float,\n            name : iridescenceThickness\n        },\n        {\n            type : float,\n            name : clearCoat\n        },\n        {\n            type : float,\n            name : clearCoatRoughness\n        },\n        {\n            type : float,\n            name : anisotropy\n        },\n        {\n            type : float4,\n            name : emissive\n        }\n    ],\n    specularAntiAliasing : true\n}\n\nfragment {\n    void material(inout MaterialInputs material) {\n        prepareMaterial(material);\n        material.baseColor.rgb = materialParams.baseColor;\n        material.roughness = materialParams.roughness;\n        material.metallic = materialParams.metallic;\n        material.reflectance = materialParams.reflectance;\n        material.secondRoughness = materialParams.secondRoughness;\n        material.secondRoughnessWeight = materialParams.secondRoughnessWeight;\n        material.sheenColor = materialParams.sheenColor;\n        material.sheenRoughness = materialParams.sheenRoughness;\n        material.iridescence = materialParams.iridescence;\n        material.iridescenceIor = materialParams.iridescenceIor;\n        material.iridescenceThickness = materialParams.iridescenceThickness;\n        material.clearCoat = materialParams.clearCoat;\n        material.clearCoatRoughness = materialParams.clearCoatRoughness;\n        material.anisotropy = materialParams.anisotropy;\n        material.emissive = materialParams.emissive;\n    }\n}\n"), -4.4, 0.0, 0.0);
s.add_at(fil.sphere(0.5, 24), fil.material("sandboxLitFade", "material {\n    name : LitFade,\n    shadingModel : lit,\n    blending : fade,\n    apiLevel : 2,\n    parameters : [\n        {\n            type : float,\n            name : alpha\n        },\n        {\n            type : float3,\n            name : baseColor\n        },\n        {\n            type : float,\n            name : roughness\n        },\n        {\n            type : float,\n            name : metallic\n        },\n        {\n            type : float,\n            name : reflectance\n        },\n        {\n            type : float,\n            name : secondRoughness\n        },\n        {\n            type : float,\n            name : secondRoughnessWeight\n        },\n        {\n            type : float3,\n            name : sheenColor\n        },\n        {\n            type : float,\n            name : sheenRoughness\n        },\n        {\n            type : float,\n            name : iridescence\n        },\n        {\n            type : float,\n            name : iridescenceIor\n        },\n        {\n            type : float,\n            name : iridescenceThickness\n        },\n        {\n            type : float,\n            name : clearCoat\n        },\n        {\n            type : float,\n            name : clearCoatRoughness\n        },\n        {\n            type : float,\n            name : anisotropy\n        },\n        {\n            type : float4,\n            name : emissive\n        }\n    ],\n    specularAntiAliasing : true\n}\n\nfragment {\n    void material(inout MaterialInputs material) {\n        prepareMaterial(material);\n        material.baseColor.rgb = materialParams.baseColor * materialParams.alpha;\n        material.baseColor.a = materialParams.alpha;\n        material.roughness = materialParams.roughness;\n        material.metallic = materialParams.metallic;\n        material.reflectance = materialParams.reflectance;\n        material.secondRoughness = materialParams.secondRoughness;\n        material.secondRoughnessWeight = materialParams.secondRoughnessWeight;\n        material.sheenColor = materialParams.sheenColor;\n        material.sheenRoughness = materialParams.sheenRoughness;\n        material.iridescence = materialParams.iridescence;\n        material.iridescenceIor = materialParams.iridescenceIor;\n        material.iridescenceThickness = materialParams.iridescenceThickness;\n        material.clearCoat = materialParams.clearCoat;\n        material.clearCoatRoughness = materialParams.clearCoatRoughness;\n        material.anisotropy = materialParams.anisotropy;\n        material.emissive = materialParams.emissive;\n    }\n}\n"), -3.3, 0.0, 0.0);
s.add_at(fil.sphere(0.5, 24), fil.material("sandboxLitTransparent", "material {\n    name : LitTransparent,\n    shadingModel : lit,\n    blending : transparent,\n    apiLevel : 2,\n    parameters : [\n        {\n            type : float,\n            name : alpha\n        },\n        {\n            type : float3,\n            name : baseColor\n        },\n        {\n            type : float,\n            name : roughness\n        },\n        {\n            type : float,\n            name : metallic\n        },\n        {\n            type : float,\n            name : reflectance\n        },\n        {\n            type : float,\n            name : secondRoughness\n        },\n        {\n            type : float,\n            name : secondRoughnessWeight\n        },\n        {\n            type : float3,\n            name : sheenColor\n        },\n        {\n            type : float,\n            name : sheenRoughness\n        },\n        {\n            type : float,\n            name : iridescence\n        },\n        {\n            type : float,\n            name : iridescenceIor\n        },\n        {\n            type : float,\n            name : iridescenceThickness\n        },\n        {\n            type : float,\n            name : clearCoat\n        },\n        {\n            type : float,\n            name : clearCoatRoughness\n        },\n        {\n            type : float,\n            name : anisotropy\n        },\n        {\n            type : float4,\n            name : emissive\n        }\n    ],\n    specularAntiAliasing : true\n}\n\nfragment {\n    void material(inout MaterialInputs material) {\n        prepareMaterial(material);\n        material.baseColor.rgb = materialParams.baseColor * materialParams.alpha;\n        material.baseColor.a = materialParams.alpha;\n        material.roughness = materialParams.roughness;\n        material.metallic = materialParams.metallic;\n        material.reflectance = materialParams.reflectance;\n        material.secondRoughness = materialParams.secondRoughness;\n        material.secondRoughnessWeight = materialParams.secondRoughnessWeight;\n        material.sheenColor = materialParams.sheenColor;\n        material.sheenRoughness = materialParams.sheenRoughness;\n        material.iridescence = materialParams.iridescence;\n        material.iridescenceIor = materialParams.iridescenceIor;\n        material.iridescenceThickness = materialParams.iridescenceThickness;\n        material.clearCoat = materialParams.clearCoat;\n        material.clearCoatRoughness = materialParams.clearCoatRoughness;\n        material.anisotropy = materialParams.anisotropy;\n        material.emissive = materialParams.emissive;\n    }\n}\n"), -2.2, 0.0, 0.0);
s.add_at(fil.sphere(0.5, 24), fil.material("sandboxLitSolidRefraction", "material {\n    name : SolidRefraction,\n    shadingModel : lit,\n    refractionType : solid,\n    refractionMode : cubemap,\n    apiLevel : 2,\n    parameters : [\n        {\n            type : float,\n            name : alpha\n        },\n        {\n            type : float3,\n            name : baseColor\n        },\n        {\n            type : float,\n            name : roughness\n        },\n        {\n            type : float,\n            name : metallic\n        },\n        {\n            type : float,\n            name : secondRoughness\n        },\n        {\n            type : float,\n            name : secondRoughnessWeight\n        },\n        {\n            type : float3,\n            name : sheenColor\n        },\n        {\n            type : float,\n            name : sheenRoughness\n        },\n        {\n            type : float,\n            name : iridescence\n        },\n        {\n            type : float,\n            name : iridescenceIor\n        },\n        {\n            type : float,\n            name : iridescenceThickness\n        },\n        {\n            type : float,\n            name : clearCoat\n        },\n        {\n            type : float,\n            name : clearCoatRoughness\n        },\n        {\n            type : float,\n            name : anisotropy\n        },\n        {\n            type : float3,\n            name : absorption\n        },\n        {\n            type : float,\n            name : thickness\n        },\n        {\n            type : float,\n            name : ior\n        },\n        {\n            type : float,\n            name : transmission\n        },\n        {\n            type : float,\n            name : dispersion\n        },\n        {\n            type : float4,\n            name : emissive\n        }\n    ],\n    specularAntiAliasing : true\n}\n\nfragment {\n    void material(inout MaterialInputs material) {\n        prepareMaterial(material);\n        material.baseColor.rgb = materialParams.baseColor * materialParams.alpha;\n        material.baseColor.a = materialParams.alpha;\n        material.roughness = materialParams.roughness;\n        material.metallic = materialParams.metallic;\n        material.secondRoughness = materialParams.secondRoughness;\n        material.secondRoughnessWeight = materialParams.secondRoughnessWeight;\n        material.sheenColor = materialParams.sheenColor;\n        material.sheenRoughness = materialParams.sheenRoughness;\n        material.iridescence = materialParams.iridescence;\n        material.iridescenceIor = materialParams.iridescenceIor;\n        material.iridescenceThickness = materialParams.iridescenceThickness;\n        material.clearCoat = materialParams.clearCoat;\n        material.clearCoatRoughness = materialParams.clearCoatRoughness;\n        material.anisotropy = materialParams.anisotropy;\n        material.absorption = materialParams.absorption;\n        material.thickness = materialParams.thickness;\n        material.ior = materialParams.ior;\n        material.transmission = materialParams.transmission;\n        material.dispersion = materialParams.dispersion;\n        material.emissive = materialParams.emissive;\n    }\n}\n"), -1.1, 0.0, 0.0);
s.add_at(fil.sphere(0.5, 24), fil.material("sandboxLitThinRefraction", "material {\n    name : ThinRefraction,\n    shadingModel : lit,\n    refractionType : thin,\n    refractionMode : cubemap,\n    apiLevel : 2,\n    parameters : [\n        {\n            type : float,\n            name : alpha\n        },\n        {\n            type : float3,\n            name : baseColor\n        },\n        {\n            type : float,\n            name : roughness\n        },\n        {\n            type : float,\n            name : metallic\n        },\n        {\n            type : float,\n            name : secondRoughness\n        },\n        {\n            type : float,\n            name : secondRoughnessWeight\n        },\n        {\n            type : float3,\n            name : sheenColor\n        },\n        {\n            type : float,\n            name : sheenRoughness\n        },\n        {\n            type : float,\n            name : iridescence\n        },\n        {\n            type : float,\n            name : iridescenceIor\n        },\n        {\n            type : float,\n            name : iridescenceThickness\n        },\n        {\n            type : float,\n            name : clearCoat\n        },\n        {\n            type : float,\n            name : clearCoatRoughness\n        },\n        {\n            type : float,\n            name : anisotropy\n        },\n        {\n            type : float3,\n            name : absorption\n        },\n        {\n            type : float,\n            name : thickness\n        },\n        {\n            type : float,\n            name : ior\n        },\n        {\n            type : float,\n            name : transmission\n        },\n        {\n            type : float4,\n            name : emissive\n        }\n    ],\n    specularAntiAliasing : true\n}\n\nfragment {\n    void material(inout MaterialInputs material) {\n        prepareMaterial(material);\n        material.baseColor.rgb = materialParams.baseColor * materialParams.alpha;\n        material.baseColor.a = materialParams.alpha;\n        material.roughness = materialParams.roughness;\n        material.metallic = materialParams.metallic;\n        material.secondRoughness = materialParams.secondRoughness;\n        material.secondRoughnessWeight = materialParams.secondRoughnessWeight;\n        material.sheenColor = materialParams.sheenColor;\n        material.sheenRoughness = materialParams.sheenRoughness;\n        material.iridescence = materialParams.iridescence;\n        material.iridescenceIor = materialParams.iridescenceIor;\n        material.iridescenceThickness = materialParams.iridescenceThickness;\n        material.clearCoat = materialParams.clearCoat;\n        material.clearCoatRoughness = materialParams.clearCoatRoughness;\n        material.anisotropy = materialParams.anisotropy;\n        material.absorption = materialParams.absorption;\n        material.microThickness = materialParams.thickness;\n        material.ior = materialParams.ior;\n        material.transmission = materialParams.transmission;\n        material.emissive = materialParams.emissive;\n    }\n}\n"), 0.0, 0.0, 0.0);
s.add_at(fil.sphere(0.5, 24), fil.material("sandboxCloth", "material {\n    name : Cloth,\n    shadingModel : cloth,\n    parameters : [\n        {\n            type : float3,\n            name : baseColor\n        },\n        {\n            type : float,\n            name : roughness\n        },\n        {\n            type : float3,\n            name : sheenColor\n        },\n        {\n            type : float3,\n            name : subsurfaceColor\n        }\n    ],\n    specularAntiAliasing : true\n}\n\nfragment {\n    void material(inout MaterialInputs material) {\n        prepareMaterial(material);\n        material.baseColor.rgb = materialParams.baseColor;\n        material.roughness = materialParams.roughness;\n        material.sheenColor = materialParams.sheenColor;\n        material.subsurfaceColor = materialParams.subsurfaceColor;\n    }\n}\n"), 1.1, 0.0, 0.0);
s.add_at(fil.sphere(0.5, 24), fil.material("sandboxSubsurface", "material {\n    name : Subsurface,\n    shadingModel : subsurface,\n    parameters : [\n        {\n            type : float3,\n            name : baseColor\n        },\n        {\n            type : float,\n            name : roughness\n        },\n        {\n            type : float,\n            name : metallic\n        },\n        {\n            type : float,\n            name : reflectance\n        },\n        {\n            type : float,\n            name : thickness\n        },\n        {\n            type : float,\n            name : subsurfacePower\n        },\n        {\n            type : float3,\n            name : subsurfaceColor\n        },\n        {\n            type : float4,\n            name : emissive\n        }\n    ],\n    specularAntiAliasing : true\n}\n\nfragment {\n    void material(inout MaterialInputs material) {\n        prepareMaterial(material);\n        material.baseColor.rgb = materialParams.baseColor;\n        material.roughness = materialParams.roughness;\n        material.metallic = materialParams.metallic;\n        material.reflectance = materialParams.reflectance;\n        material.thickness = materialParams.thickness;\n        material.subsurfacePower = materialParams.subsurfacePower;\n        material.subsurfaceColor = materialParams.subsurfaceColor;\n        material.emissive = materialParams.emissive;\n    }\n}\n"), 2.2, 0.0, 0.0);
s.add_at(fil.sphere(0.5, 24), fil.material("sandboxSpecGloss", "material {\n    name : SpecularGlossiness,\n    shadingModel : specularGlossiness,\n    parameters : [\n        {\n            type : float3,\n            name : baseColor\n        },\n        {\n            type : float,\n            name : glossiness\n        },\n        {\n            type : float3,\n            name : specularColor\n        },\n        {\n            type : float,\n            name : reflectance\n        },\n        {\n            type : float,\n            name : clearCoat\n        },\n        {\n            type : float,\n            name : clearCoatRoughness\n        },\n        {\n            type : float,\n            name : anisotropy\n        },\n        {\n            type : float4,\n            name : emissive\n        }\n    ],\n    specularAntiAliasing : true\n}\n\nfragment {\n    void material(inout MaterialInputs material) {\n        prepareMaterial(material);\n        material.baseColor.rgb = materialParams.baseColor;\n        material.glossiness = materialParams.glossiness;\n        material.specularColor = materialParams.specularColor;\n        material.clearCoat = materialParams.clearCoat;\n        material.clearCoatRoughness = materialParams.clearCoatRoughness;\n        material.anisotropy = materialParams.anisotropy;\n        material.emissive = materialParams.emissive;\n    }\n}\n"), 3.3, 0.0, 0.0);
s.add_at(fil.sphere(0.5, 24), fil.material("sandboxUnlit", "material {\n    name : Unlit,\n    shadingModel : unlit,\n    parameters : [\n        {\n            type : float3,\n            name : baseColor\n        },\n        {\n            type : float4,\n            name : emissive\n        }\n    ],\n}\n\nfragment {\n    void material(inout MaterialInputs material) {\n        prepareMaterial(material);\n        material.baseColor.rgb = materialParams.baseColor;\n        material.emissive = materialParams.emissive;\n    }\n}\n"), 4.4, 0.0, 0.0);
s.render_frames(1);
s.render_png("images/material_sandbox.png", 800, 600);
end _lmcode_
savedsl(p, out);
r = system(concat(dsl_cli(p), ["--dsl", out]), 900000);
if (r.code != 0) { println(r.stderr + r.stdout); }
assert(r.code == 0);
println("ok material_sandbox");
