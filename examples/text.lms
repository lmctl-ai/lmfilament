# lmfilament port of Magnum Python example "Text" (https://doc.magnum.graphics/python/examples/#text)
# Two lines of voxel text (`fil.text`) from a built-in 5x7 font; Magnum renders distance-field glyphs from a font file, which a static binary without a font stack cannot do.
# Run anywhere: lmctl autorun https://raw.githubusercontent.com/lmctl-ai/lmfilament/main/examples/text.lms
# Filament runs on its noop backend; the picture comes from lmfilament's CPU preview rasterizer (images/text.png).
out = ARGV.len() > 0 ? ARGV[0] : "build/text.dslb";
mkdir("build");
mkdir("images");
p = _dsl_ cli="lmfilament" install="github:lmctl-ai/lmfilament@latest";
let mat = fil.material("aiDefaultMat", "material {\n    name : AssimpDefaultMat,\n    shadingModel : lit,\n    parameters : [\n        {\n            type : float3,\n            name : baseColor\n        },\n        {\n            type : float,\n            name : metallic\n        },\n        {\n            type : float,\n            name : roughness\n        },\n        {\n            type : float,\n            name : reflectance\n        }\n    ],\n}\n\nfragment {\n    void material(inout MaterialInputs material) {\n        prepareMaterial(material);\n        material.baseColor.rgb = materialParams.baseColor;\n        material.metallic = materialParams.metallic;\n        material.roughness = materialParams.roughness;\n        material.reflectance = materialParams.reflectance;\n    }\n}\n");
mat.set_float("metallic", 0.0);
mat.set_float("roughness", 0.45);
let s = fil.scene();
s.skybox(0.03, 0.035, 0.05);
mat.set_float3("baseColor", 0.95, 0.85, 0.3);
s.add_part(fil.text("HELLO, WORLD!", 0.7), mat).translate(-3.8, 0.4, 0.0).rotate(0.0, 8.0, 0.0);
mat.set_float3("baseColor", 0.5, 0.75, 0.95);
s.add_part(fil.text("FILAMENT 1.78", 0.5), mat).translate(-2.6, -0.6, 0.0).rotate(0.0, 8.0, 0.0);
s.directional_light(1.0, 1.0, 1.0, 110000.0, -0.4, -0.7, -0.6);
s.camera(38.0, 0.0, 0.8, 13.0, 0.0, 0.2, 0.0);
s.render_frames(2);
s.render_png("images/text.png", 800, 400);
end _dsl_
savedsl(p, out);
r = system(concat(dsl_cli(p), ["--dsl", out]), 900000);
if (r.code != 0) { println(r.stderr + r.stdout); }
assert(r.code == 0);
println("ok text");
