# lmfilament port of upstream samples/materials/*.mat
# Compiles every upstream sample material to build/materials/NAME.filamat (all 28 files).
# Run from the repo root (asset paths are relative): lmscript examples/compile-sample-materials.lms
# Filament runs on its noop backend here, so the scene is built and "rendered" without pixels.
out = ARGV.len() > 0 ? ARGV[0] : "build/compile-sample-materials.dslb";
mkdir("build");
mkdir("build/materials");
p = _dsl_ cli="lmfilament" install="github:lmctl-ai/lmfilament@latest";
fil.material_file("third_party/filament/samples/materials/aiDefaultMat.mat").save("build/materials/aiDefaultMat.filamat");
fil.material_file("third_party/filament/samples/materials/aoPreview.mat").save("build/materials/aoPreview.filamat");
fil.material_file("third_party/filament/samples/materials/arrayTexture.mat").save("build/materials/arrayTexture.filamat");
fil.material_file("third_party/filament/samples/materials/bakedColor.mat").save("build/materials/bakedColor.filamat");
fil.material_file("third_party/filament/samples/materials/bakedTexture.mat").save("build/materials/bakedTexture.filamat");
fil.material_file("third_party/filament/samples/materials/depthVisualizer.mat").save("build/materials/depthVisualizer.filamat");
fil.material_file("third_party/filament/samples/materials/groundShadow.mat").save("build/materials/groundShadow.filamat");
fil.material_file("third_party/filament/samples/materials/heightfield.mat").save("build/materials/heightfield.filamat");
fil.material_file("third_party/filament/samples/materials/image.mat").save("build/materials/image.filamat");
fil.material_file("third_party/filament/samples/materials/mirror.mat").save("build/materials/mirror.filamat");
fil.material_file("third_party/filament/samples/materials/overdraw.mat").save("build/materials/overdraw.filamat");
fil.material_file("third_party/filament/samples/materials/pointSprites.mat").save("build/materials/pointSprites.filamat");
fil.material_file("third_party/filament/samples/materials/proceduralEffect.mat").save("build/materials/proceduralEffect.filamat");
fil.material_file("third_party/filament/samples/materials/proceduralTextureQuad.mat").save("build/materials/proceduralTextureQuad.filamat");
fil.material_file("third_party/filament/samples/materials/sandboxCloth.mat").save("build/materials/sandboxCloth.filamat");
fil.material_file("third_party/filament/samples/materials/sandboxLit.mat").save("build/materials/sandboxLit.filamat");
fil.material_file("third_party/filament/samples/materials/sandboxLitFade.mat").save("build/materials/sandboxLitFade.filamat");
fil.material_file("third_party/filament/samples/materials/sandboxLitSolidRefraction.mat").save("build/materials/sandboxLitSolidRefraction.filamat");
fil.material_file("third_party/filament/samples/materials/sandboxLitSolidRefractionSsr.mat").save("build/materials/sandboxLitSolidRefractionSsr.filamat");
fil.material_file("third_party/filament/samples/materials/sandboxLitThinRefraction.mat").save("build/materials/sandboxLitThinRefraction.filamat");
fil.material_file("third_party/filament/samples/materials/sandboxLitThinRefractionSsr.mat").save("build/materials/sandboxLitThinRefractionSsr.filamat");
fil.material_file("third_party/filament/samples/materials/sandboxLitTransparent.mat").save("build/materials/sandboxLitTransparent.filamat");
fil.material_file("third_party/filament/samples/materials/sandboxSpecGloss.mat").save("build/materials/sandboxSpecGloss.filamat");
fil.material_file("third_party/filament/samples/materials/sandboxSubsurface.mat").save("build/materials/sandboxSubsurface.filamat");
fil.material_file("third_party/filament/samples/materials/sandboxUnlit.mat").save("build/materials/sandboxUnlit.filamat");
fil.material_file("third_party/filament/samples/materials/texturedLit.mat").save("build/materials/texturedLit.filamat");
fil.material_file("third_party/filament/samples/materials/transparentColor.mat").save("build/materials/transparentColor.filamat");
fil.material_file("third_party/filament/samples/materials/uvmorph.mat").save("build/materials/uvmorph.filamat");
end _dsl_
savedsl(p, out);
r = system(concat(dsl_cli(p), ["--dsl", out]), 900000);
if (r.code != 0) { println(r.stderr + r.stdout); }
assert(r.code == 0);
println("ok compile-sample-materials");
