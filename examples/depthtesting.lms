# lmfilament port of upstream samples/depthtesting.cpp
# Two overlapping colored triangles at different depths, the setup used to exercise depth testing.
# Run anywhere: lmctl autorun https://raw.githubusercontent.com/lmctl-ai/lmfilament/main/examples/depthtesting.lms
# Filament runs on its noop backend; the picture comes from lmfilament's CPU preview rasterizer (images/depthtesting.png).
out = ARGV.len() > 0 ? ARGV[0] : "build/depthtesting.dslb";
mkdir("build");
mkdir("build/materials");
mkdir("images");
p = _lmcode_ cli="lmfilament" install="github:lmctl-ai/lmfilament@latest";
let mat = fil.material("bakedColor", "material {\n    name : BakedColor,\n    requires : [\n        color\n    ],\n    shadingModel : unlit,\n    culling : none,\n    featureLevel : 0\n}\n\nfragment {\n    void material(inout MaterialInputs material) {\n        prepareMaterial(material);\n        material.baseColor = getColor();\n    }\n}\n");
let s = fil.scene();
s.skybox(0.1, 0.125, 0.25);
s.camera(45.0, 0.0, 0.0, 4.0, 0.0, 0.0, 0.0);
s.add_at(fil.triangle(), mat, 0.0, 0.0, -0.5);
s.add_at(fil.triangle(), mat, 0.4, 0.2, 0.5);
s.render_frames(2);
s.render_png("images/depthtesting.png", 800, 600);
end _lmcode_
savedsl(p, out);
r = system(concat(dsl_cli(p), ["--dsl", out]), 900000);
if (r.code != 0) { println(r.stderr + r.stdout); }
assert(r.code == 0);
println("ok depthtesting");
