# lmfilament port of upstream samples/vbotest.cpp
# Vertex buffer layout test: interleaved position + packed ubyte4 color, here the shared triangle mesh with bakedColor.
# Run from the repo root (asset paths are relative): lmscript examples/vbotest.lms
# Filament runs on its noop backend here, so the scene is built and "rendered" without pixels.
out = ARGV.len() > 0 ? ARGV[0] : "build/vbotest.dslb";
mkdir("build");
mkdir("build/materials");
p = _dsl_ cli="lmfilament" install="github:lmctl-ai/lmfilament@latest";
let mat = fil.material_file("third_party/filament/samples/materials/bakedColor.mat");
let tri = fil.triangle();
let s = fil.scene();
s.camera(45.0, 0.0, 0.0, 3.0, 0.0, 0.0, 0.0);
s.add(tri, mat);
s.render_frames(1);
end _dsl_
savedsl(p, out);
r = system(concat(dsl_cli(p), ["--dsl", out]), 900000);
if (r.code != 0) { println(r.stderr + r.stdout); }
assert(r.code == 0);
println("ok vbotest");
