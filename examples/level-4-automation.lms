# Level 4: automation: one of the four 10 s clips (240 frames at 24 fps) on https://lmctl.com, from lmctl-ai/lmctl scripts/homepage/video.
# A brainstorm becomes a Work, Review, QA and Acceptance pipeline that agents write and run.
# Writes images/level-4-automation.png (frame 150), images/level-4-automation.mp4 and images/level-4-automation.gif (the last two need ffmpeg) and build/level-4-automation/frame-N.png.
out = ARGV.len() > 0 ? ARGV[0] : "build/level-4-automation.dslb";
mkdir("images");
mkdir("build");
mkdir("build/level-4-automation");
p = _lmcode_ cli="lmfilament" install="github:lmctl-ai/lmfilament@latest";
let mat = fil.material("aiDefaultMat", "material {\n    name : AssimpDefaultMat,\n    shadingModel : lit,\n    parameters : [\n        {\n            type : float3,\n            name : baseColor\n        },\n        {\n            type : float,\n            name : metallic\n        },\n        {\n            type : float,\n            name : roughness\n        },\n        {\n            type : float,\n            name : reflectance\n        }\n    ],\n}\n\nfragment {\n    void material(inout MaterialInputs material) {\n        prepareMaterial(material);\n        material.baseColor.rgb = materialParams.baseColor;\n        material.metallic = materialParams.metallic;\n        material.roughness = materialParams.roughness;\n        material.reflectance = materialParams.reflectance;\n    }\n}\n");
mat.set_float("metallic", 0.0);
mat.set_float("roughness", 0.45);
let scn = fil.scene();
let frame_count = 240;
let render_width = 480;
let render_height = 270;
let flow_period = 96;

# Shared look block: keep identical in all four homepage storyboards.
scn.skybox(0.00271, 0.00440, 0.01002);
scn.directional_light(1.0, 1.0, 1.0, 90200.0, -0.55, -1.0, -0.45);

# Brainstorming starts with a person and two architect agents.
mat.set_float3("baseColor", 0.14, 0.78, 0.68);
let human = scn.add_part(fil.sphere(0.56, 32), mat).translate(-8.0, 1.2, 0.0);
mat.set_float3("baseColor", 0.14, 0.78, 0.68);
let human_body = scn.add_part(fil.cylinder(0.38, 1.2, 32), mat).translate(-8.0, 0.05, 0.0);
mat.set_float3("baseColor", 0.18, 0.60, 0.94);
let architect0 = scn.add_part(fil.sphere(0.52, 32), mat).translate(-6.6, 1.55, 0.0);
mat.set_float3("baseColor", 0.62, 0.45, 0.94);
let architect1 = scn.add_part(fil.sphere(0.52, 32), mat).translate(-3.9, 0.15, 0.0);

# A long flat gold panel unrolls in four sections; no text is drawn.
mat.set_float3("baseColor", 0.98, 0.68, 0.20);
let panel0 = scn.add_part(fil.box(1.90, 0.48, 0.30), mat).translate(-2.95, 2.6, -0.2).visible(false);
mat.set_float3("baseColor", 0.98, 0.68, 0.20);
let panel1 = scn.add_part(fil.box(1.90, 0.48, 0.30), mat).translate(-0.98, 2.6, -0.2).visible(false);
mat.set_float3("baseColor", 0.98, 0.68, 0.20);
let panel2 = scn.add_part(fil.box(1.90, 0.48, 0.30), mat).translate(0.98, 2.6, -0.2).visible(false);
mat.set_float3("baseColor", 0.98, 0.68, 0.20);
let panel3 = scn.add_part(fil.box(1.90, 0.48, 0.30), mat).translate(2.95, 2.6, -0.2).visible(false);
mat.set_float3("baseColor", 0.18, 0.60, 0.94);
let script_line0 = scn.add_part(fil.box(1.30, 0.07, 0.10), mat).translate(-2.95, 2.72, 0.02).visible(false);
mat.set_float3("baseColor", 0.18, 0.60, 0.94);
let script_line1 = scn.add_part(fil.box(1.30, 0.07, 0.10), mat).translate(-0.98, 2.72, 0.02).visible(false);
mat.set_float3("baseColor", 0.62, 0.45, 0.94);
let script_line2 = scn.add_part(fil.box(1.30, 0.07, 0.10), mat).translate(0.98, 2.50, 0.02).visible(false);
mat.set_float3("baseColor", 0.62, 0.45, 0.94);
let script_line3 = scn.add_part(fil.box(1.30, 0.07, 0.10), mat).translate(2.95, 2.50, 0.02).visible(false);

# Four visible stages: work, review, QA, acceptance.
mat.set_float3("baseColor", 0.18, 0.60, 0.94);
let work = scn.add_part(fil.box(1.9, 1.1, 0.48), mat).translate(-5.0, -1.1, 0.0).visible(false);
mat.set_float3("baseColor", 0.62, 0.45, 0.94);
let review = scn.add_part(fil.box(1.9, 1.1, 0.48), mat).translate(-1.7, -1.1, 0.0).visible(false);
mat.set_float3("baseColor", 0.96, 0.38, 0.28);
let qa = scn.add_part(fil.box(1.9, 1.1, 0.48), mat).translate(1.7, -1.1, 0.0).visible(false);
mat.set_float3("baseColor", 0.28, 0.80, 0.48);
let acceptance = scn.add_part(fil.box(1.9, 1.1, 0.48), mat).translate(5.0, -1.1, 0.0).visible(false);
mat.set_float3("baseColor", 0.18, 0.60, 0.94);
let worker0 = scn.add_part(fil.sphere(0.42, 32), mat).translate(-5.0, 0.25, 0.0).visible(false);
mat.set_float3("baseColor", 0.62, 0.45, 0.94);
let worker1 = scn.add_part(fil.sphere(0.42, 32), mat).translate(-1.7, 0.25, 0.0).visible(false);
mat.set_float3("baseColor", 0.96, 0.38, 0.28);
let worker2 = scn.add_part(fil.sphere(0.42, 32), mat).translate(1.7, 0.25, 0.0).visible(false);
mat.set_float3("baseColor", 0.28, 0.80, 0.48);
let worker3 = scn.add_part(fil.sphere(0.42, 32), mat).translate(5.0, 0.25, 0.0).visible(false);
mat.set_float3("baseColor", 0.14, 0.78, 0.68);
let human_right = scn.add_part(fil.sphere(0.56, 32), mat).translate(8.3, -0.45, 0.0).visible(false);
mat.set_float3("baseColor", 0.14, 0.78, 0.68);
let human_right_body = scn.add_part(fil.cylinder(0.38, 1.1, 32), mat).translate(8.3, -1.55, 0.0).visible(false);

# Gold dots make the review loop visible as a return arc to the work stage.
mat.set_float3("baseColor", 0.98, 0.68, 0.20);
let arc0 = scn.add_part(fil.sphere(0.09, 32), mat).translate(-1.5, 0.2, 0.65);
mat.set_float3("baseColor", 0.98, 0.68, 0.20);
let arc1 = scn.add_part(fil.sphere(0.09, 32), mat).translate(-2.0, 0.7, 0.65);
mat.set_float3("baseColor", 0.98, 0.68, 0.20);
let arc2 = scn.add_part(fil.sphere(0.09, 32), mat).translate(-2.7, 1.1, 0.65);
mat.set_float3("baseColor", 0.98, 0.68, 0.20);
let arc3 = scn.add_part(fil.sphere(0.09, 32), mat).translate(-3.5, 1.25, 0.65);
mat.set_float3("baseColor", 0.98, 0.68, 0.20);
let arc4 = scn.add_part(fil.sphere(0.09, 32), mat).translate(-4.3, 1.1, 0.65);
mat.set_float3("baseColor", 0.98, 0.68, 0.20);
let arc5 = scn.add_part(fil.sphere(0.09, 32), mat).translate(-4.8, 0.7, 0.65);
mat.set_float3("baseColor", 0.98, 0.68, 0.20);
let arc6 = scn.add_part(fil.sphere(0.09, 32), mat).translate(-5.0, 0.2, 0.65);

# A green check shape marks the acceptance stage.
mat.set_float3("baseColor", 0.28, 0.80, 0.48);
let tick_short = scn.add_part(fil.box(0.58, 0.18, 0.20), mat).translate(6.45, -1.20, 0.55).rotate(0.00, 0.00, -41.25).visible(false);
mat.set_float3("baseColor", 0.28, 0.80, 0.48);
let tick_long = scn.add_part(fil.box(0.96, 0.18, 0.20), mat).translate(7.05, -0.99, 0.55).rotate(0.00, 0.00, 35.52).visible(false);
mat.set_float3("baseColor", 0.98, 0.68, 0.20);
let token = scn.add_part(fil.sphere(0.20, 32), mat);
let fov = 44.0;
scn.camera(fov, 0.0, 0.0, 15.5, 0.0, 0.0, 0.0);
for (frame in range(0, frame_count)) {
  let t = float(frame) / float(frame_count - 1);
  panel0.visible(t > 0.02); panel1.visible(t > 0.07); panel2.visible(t > 0.12); panel3.visible(t > 0.17);
  script_line0.visible(t > 0.07); script_line1.visible(t > 0.12); script_line2.visible(t > 0.17); script_line3.visible(t > 0.22);

  let spawn_t = t > 0.24;
  work.visible(spawn_t); worker0.visible(spawn_t);
  review.visible(t > 0.32); worker1.visible(t > 0.32);
  qa.visible(t > 0.40); worker2.visible(t > 0.40);
  acceptance.visible(t > 0.48); worker3.visible(t > 0.48);
  human_right.visible(t > 0.80); human_right_body.visible(t > 0.80);

  let tick_t = t > 0.82;
  tick_short.visible(tick_t); tick_long.visible(tick_t);

  let cycle = float(frame % flow_period) / float(flow_period - 1);
  if (cycle < 0.68) {
    let flow_t = ease(cycle / 0.68);
    token.translate(lerp(-5.0, 5.0, flow_t), -1.1, 0.85);
  } else {
    let return_t = ease((cycle - 0.68) / 0.32);
    token.translate(lerp(-1.7, -5.0, return_t), lerp(-0.15, 0.2, sin(return_t * 3.14159)), 0.85);
  }
  scn.render_png("build/level-4-automation/frame-" + str(frame) + ".png", render_width, render_height);
  if (frame == 150) { scn.render_png("images/level-4-automation.png", render_width, render_height); }
}
end _lmcode_
savedsl(p, out);
# run the bytecode with the host it was compiled against (the 240 frames take a while: 10 min limit)
r = system(concat(dsl_cli(p), ["--dsl", out]), 3000000);
if (r.code != 0) { println(r.stderr + r.stdout); }
assert(r.code == 0);
println("ok level-4-automation");
if (which("ffmpeg") != null) {
  a = system ffmpeg -y -loglevel error -framerate 24 -i build/level-4-automation/frame-%d.png -c:v libx264 -pix_fmt yuv420p -crf 22 images/level-4-automation.mp4;
  assert(a.code == 0);
  b = system ffmpeg -y -loglevel error -framerate 24 -i build/level-4-automation/frame-%d.png -vf "fps=12,scale=480:-1:flags=lanczos,split[a][b];[a]palettegen=max_colors=64[p];[b][p]paletteuse=dither=none" -loop 0 images/level-4-automation.gif;
  assert(b.code == 0);
  println("wrote images/level-4-automation.mp4 and images/level-4-automation.gif");
} else {
  println("ffmpeg not found: skipped the MP4 and GIF (build/level-4-automation/frame-*.png are the 240 frames)");
}
