# Magnum example "3D Fluid Simulation" (https://magnum.graphics/doc/magnum/examples-fluidsimulation3d.html), reproduced headless as flow visualisation: Magnum's example runs a particle fluid on the GPU; there is no simulator or arrays here, so this integrates 32 streamlines of the ABC (Arnold-Beltrami-Childress) flow with midpoint steps, drawn as tube chains coloured by speed (blue slow, orange fast).
out = ARGV.len() > 0 ? ARGV[0] : "build/fluidsimulation3d.dslb";
mkdir("images");
mkdir("build");
p = _lmcode_ cli="lmfilament" install="github:lmctl-ai/lmfilament@latest";
let mat = fil.material("aiDefaultMat", "material {\n    name : AssimpDefaultMat,\n    shadingModel : lit,\n    parameters : [\n        {\n            type : float3,\n            name : baseColor\n        },\n        {\n            type : float,\n            name : metallic\n        },\n        {\n            type : float,\n            name : roughness\n        },\n        {\n            type : float,\n            name : reflectance\n        }\n    ],\n}\n\nfragment {\n    void material(inout MaterialInputs material) {\n        prepareMaterial(material);\n        material.baseColor.rgb = materialParams.baseColor;\n        material.metallic = materialParams.metallic;\n        material.roughness = materialParams.roughness;\n        material.reflectance = materialParams.reflectance;\n    }\n}\n");
mat.set_float("metallic", 0.0);
mat.set_float("roughness", 0.5);
let scn = fil.scene();
scn.skybox(0.04, 0.045, 0.07);
let aa = 1.0;
let bb = 0.8165;
let cc = 0.5774;
let dt = 0.14;
for (si in range(0, 32)) {
  let ix = si - (si / 4) * 4;
  let iy = (si / 4) - (si / 16) * 4;
  let iz = si / 16;
  let x = (float(ix) + 0.5) * 1.5708 + 0.3 * float(iz);
  let y = (float(iy) + 0.5) * 1.5708;
  let z = 1.2 + 3.0 * float(iz);
  for (step in range(0, 34)) {
    let u1 = aa * sin(z) + cc * cos(y);
    let v1 = bb * sin(x) + aa * cos(z);
    let w1 = cc * sin(y) + bb * cos(x);
    let xm = x + 0.5 * dt * u1;
    let ym = y + 0.5 * dt * v1;
    let zm = z + 0.5 * dt * w1;
    let u2 = aa * sin(zm) + cc * cos(ym);
    let v2 = bb * sin(xm) + aa * cos(zm);
    let w2 = cc * sin(ym) + bb * cos(xm);
    let nx = x + dt * u2;
    let ny = y + dt * v2;
    let nz = z + dt * w2;
    let speed = sqrt(u2 * u2 + v2 * v2 + w2 * w2);
    let t = clamp(speed / 2.2, 0.0, 1.0);
    let cr = lerp(0.2, 1.0, t);
    let cg = lerp(0.4, 0.55, t);
    let cb = lerp(1.0, 0.15, t);
    let px = x - 3.14159;  let py = y - 3.14159;  let pz = z - 3.14159;
    let qx = nx - 3.14159; let qy = ny - 3.14159; let qz = nz - 3.14159;
    mat.set_float3("baseColor", cr, cg, cb);
    scn.add(fil.tube_between(px, py, pz, qx, qy, qz, 0.05), mat);
    x = nx; y = ny; z = nz;
  }
}
scn.directional_light(1.0, 1.0, 1.0, 110000.0, -0.4, -0.7, -0.6);
scn.camera(34.0, 10.0, 9.0, 13.0, 0.0, 0.0, 0.0);
scn.render_frames(1);
scn.render_png("images/fluidsimulation3d.png", 800, 600);
end _lmcode_
savedsl(p, out);
r = system(concat(dsl_cli(p), ["--lmcode", out]), 900000);
if (r.code != 0) { println(r.stderr + r.stdout); }
assert(r.code == 0);
println("ok fluidsimulation3d");
