# A water molecule with its real 104.5 degree H-O-H angle (bond lengths are stretched for legibility).
# Ported from lmcad examples/ball-stick.lms.
out = ARGV.len() > 0 ? ARGV[0] : "build/ball-stick.dslb";
mkdir("images");
mkdir("build");
p = _lmcode_ cli="lmfilament" install="github:lmctl-ai/lmfilament@latest";
let mat = fil.material("aiDefaultMat", "material {\n    name : AssimpDefaultMat,\n    shadingModel : lit,\n    parameters : [\n        {\n            type : float3,\n            name : baseColor\n        },\n        {\n            type : float,\n            name : metallic\n        },\n        {\n            type : float,\n            name : roughness\n        },\n        {\n            type : float,\n            name : reflectance\n        }\n    ],\n}\n\nfragment {\n    void material(inout MaterialInputs material) {\n        prepareMaterial(material);\n        material.baseColor.rgb = materialParams.baseColor;\n        material.metallic = materialParams.metallic;\n        material.roughness = materialParams.roughness;\n        material.reflectance = materialParams.reflectance;\n    }\n}\n");
mat.set_float("metallic", 0.0);
mat.set_float("roughness", 0.4);
let s = fil.scene();
s.skybox(0.035, 0.045, 0.07);
mat.set_float3("baseColor", 0.88, 0.08, 0.06);
s.add_at(fil.sphere(0.60, 32), mat, 0.0, 0.0, 0.0);
mat.set_float3("baseColor", 0.86, 0.90, 0.96);
s.add_at(fil.sphere(0.32, 32), mat, -1.24, 0.0, 0.96);
s.add_at(fil.sphere(0.32, 32), mat, 1.24, 0.0, 0.96);
mat.set_float3("baseColor", 0.48, 0.52, 0.60);
s.add(fil.tube_between(0.0, 0.0, 0.0, -1.24, 0.0, 0.96, 0.12), mat);
s.add(fil.tube_between(0.0, 0.0, 0.0, 1.24, 0.0, 0.96, 0.12), mat);
s.directional_light(1.0, 1.0, 1.0, 110000.0, -0.6, -1.0, -0.5);
s.camera(38.0, 0.0, 6.0, 4.0, 0.0, 0.0, 0.4);
s.render_frames(2);
s.render_png("images/ball-stick.png", 640, 480);
end _lmcode_
savedsl(p, out);
r = system(concat(dsl_cli(p), ["--lmcode", out]), 900000);
if (r.code != 0) { println(r.stderr + r.stdout); }
assert(r.code == 0);
println("ok ball-stick");
