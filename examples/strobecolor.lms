# lmfilament port of upstream samples/strobecolor.cpp
# An empty scene with only a skybox color; the upstream sample animates the color each frame.
# Run anywhere: lmctl autorun https://raw.githubusercontent.com/lmctl-ai/lmfilament/main/examples/strobecolor.lms
# Filament runs on its noop backend here, so the scene is built and "rendered" without pixels.
mkdir("build");
mkdir("build/materials");
p = _lmcode_ cli="lmfilament" install="github:lmctl-ai/lmfilament@latest";
let s = fil.scene();
s.skybox(0.0, 0.25, 0.5);
s.render_frames(5);
end _lmcode_
r = run_lmcode(p);
if (!r.ok) { println(r.stderr + r.stdout); }
assert(r.ok);
println("ok strobecolor");
