# lmfilament port of upstream samples/strobecolor.cpp
# An empty scene with only a skybox color; the upstream sample animates the color each frame.
# Run from the repo root (asset paths are relative): lmscript examples/strobecolor.lms
# Filament runs on its noop backend here, so the scene is built and "rendered" without pixels.
out = ARGV.len() > 0 ? ARGV[0] : "build/strobecolor.dslb";
mkdir("build");
mkdir("build/materials");
p = _dsl_ cli="lmfilament" install="github:lmctl-ai/lmfilament@latest";
let s = fil.scene();
s.skybox(0.0, 0.25, 0.5);
s.render_frames(5);
end _dsl_
savedsl(p, out);
r = system(concat(dsl_cli(p), ["--dsl", out]), 900000);
if (r.code != 0) { println(r.stderr + r.stdout); }
assert(r.code == 0);
println("ok strobecolor");
