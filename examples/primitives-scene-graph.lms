# lmfilament port of Magnum Python example "Primitives, using a scene graph" (https://doc.magnum.graphics/python/examples/#primitives-using-a-scene-graph)
# The same primitives, with transformations handled by Filament's TransformManager: every part is parented to a node, and the capsules hang from a second node nested under the first, so one rotation of the root moves the whole tree.
# Run anywhere: lmctl autorun https://raw.githubusercontent.com/lmctl-ai/lmfilament/main/examples/primitives-scene-graph.lms
# Filament runs on its noop backend; the picture comes from lmfilament's CPU preview rasterizer (images/primitives-scene-graph.png).
out = ARGV.len() > 0 ? ARGV[0] : "build/primitives-scene-graph.dslb";
mkdir("build");
mkdir("images");
p = _lmcode_ cli="lmfilament" install="github:lmctl-ai/lmfilament@latest";
let mat = fil.material("aiDefaultMat", "material {\n    name : AssimpDefaultMat,\n    shadingModel : lit,\n    parameters : [\n        {\n            type : float3,\n            name : baseColor\n        },\n        {\n            type : float,\n            name : metallic\n        },\n        {\n            type : float,\n            name : roughness\n        },\n        {\n            type : float,\n            name : reflectance\n        }\n    ],\n}\n\nfragment {\n    void material(inout MaterialInputs material) {\n        prepareMaterial(material);\n        material.baseColor.rgb = materialParams.baseColor;\n        material.metallic = materialParams.metallic;\n        material.roughness = materialParams.roughness;\n        material.reflectance = materialParams.reflectance;\n    }\n}\n");
mat.set_float("metallic", 0.0);
mat.set_float("roughness", 0.45);
let s = fil.scene();
s.skybox(0.03, 0.035, 0.05);
let root = s.node().rotate(12.0, -18.0, 0.0);
let arm = s.node().translate(0.0, -1.0, 0.0).rotate(0.0, 0.0, 25.0).parent(root);
mat.set_float3("baseColor", 0.85, 0.45, 0.2);
s.add_part(fil.box(1.0, 1.0, 1.0), mat).translate(-3.0, 0.0, 0.0).rotate(20.0, 30.0, 0.0).parent(root);
s.add_part(fil.sphere(0.6, 24), mat).translate(-1.5, 0.0, 0.0).parent(root);
s.add_part(fil.icosphere(0.6, 2), mat).parent(root);
s.add_part(fil.cylinder(0.5, 1.2, 48), mat).translate(1.5, 0.0, 0.0).parent(root);
s.add_part(fil.cone(0.5, 1.2, 48), mat).translate(3.0, 0.0, 0.0).parent(root);
mat.set_float3("baseColor", 0.3, 0.65, 0.85);
s.add_part(fil.capsule(0.4, 1.0, 32), mat).parent(arm);
s.add_part(fil.capsule(0.3, 0.8, 32), mat).translate(0.0, -1.2, 0.0).parent(arm);
s.directional_light(1.0, 1.0, 1.0, 110000.0, -0.5, -1.0, -0.4);
s.camera(45.0, 0.0, 1.0, 11.0, 0.0, -1.0, 0.0);
s.render_frames(2);
s.render_png("images/primitives-scene-graph.png", 800, 500);
end _lmcode_
savedsl(p, out);
r = system(concat(dsl_cli(p), ["--dsl", out]), 900000);
if (r.code != 0) { println(r.stderr + r.stdout); }
assert(r.code == 0);
println("ok primitives-scene-graph");
