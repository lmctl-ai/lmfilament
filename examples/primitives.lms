# lmfilament port of Magnum Python example "Primitives" (https://doc.magnum.graphics/python/examples/#primitives)
# Every solid primitive the host builds (box, sphere, icosphere, cylinder, cone, capsule) in one row, placed with parts that carry rotation. Magnum's version adds mouse rotation.
# Run anywhere: lmctl autorun https://raw.githubusercontent.com/lmctl-ai/lmfilament/main/examples/primitives.lms
# Filament runs on its noop backend; the picture comes from lmfilament's CPU preview rasterizer (images/primitives.png).
out = ARGV.len() > 0 ? ARGV[0] : "build/primitives.dslb";
mkdir("build");
mkdir("images");
p = _dsl_ cli="lmfilament" install="github:lmctl-ai/lmfilament@latest";
let mat = fil.material("aiDefaultMat", "material {\n    name : AssimpDefaultMat,\n    shadingModel : lit,\n    parameters : [\n        {\n            type : float3,\n            name : baseColor\n        },\n        {\n            type : float,\n            name : metallic\n        },\n        {\n            type : float,\n            name : roughness\n        },\n        {\n            type : float,\n            name : reflectance\n        }\n    ],\n}\n\nfragment {\n    void material(inout MaterialInputs material) {\n        prepareMaterial(material);\n        material.baseColor.rgb = materialParams.baseColor;\n        material.metallic = materialParams.metallic;\n        material.roughness = materialParams.roughness;\n        material.reflectance = materialParams.reflectance;\n    }\n}\n");
mat.set_float("metallic", 0.0);
mat.set_float("roughness", 0.45);
let s = fil.scene();
s.skybox(0.03, 0.035, 0.05);
mat.set_float3("baseColor", 0.85, 0.45, 0.2);
s.add_part(fil.box(1.0, 1.0, 1.0), mat).translate(-3.0, 0.0, 0.0).rotate(20.0, 30.0, 0.0);
s.add_part(fil.sphere(0.6, 24), mat).translate(-1.5, 0.0, 0.0);
s.add_part(fil.icosphere(0.6, 2), mat).translate(0.0, 0.0, 0.0);
s.add_part(fil.cylinder(0.5, 1.2, 48), mat).translate(1.5, 0.0, 0.0);
s.add_part(fil.cone(0.5, 1.2, 48), mat).translate(3.0, 0.0, 0.0);
s.add_part(fil.capsule(0.4, 1.0, 32), mat).translate(0.0, -1.6, 0.0);
s.directional_light(1.0, 1.0, 1.0, 110000.0, -0.5, -1.0, -0.4);
s.camera(45.0, 0.0, 1.5, 9.0, 0.0, -0.5, 0.0);
s.render_frames(2);
s.render_png("images/primitives.png", 800, 400);
end _dsl_
savedsl(p, out);
r = system(concat(dsl_cli(p), ["--dsl", out]), 900000);
if (r.code != 0) { println(r.stderr + r.stdout); }
assert(r.code == 0);
println("ok primitives");
