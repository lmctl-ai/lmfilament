# lmfilament port of upstream samples/hellotriangle.cpp
# One vertex-colored triangle (the upstream vertex/color constants) with the unlit bakedColor material on a dark blue skybox.
# Run from the repo root (asset paths are relative): lmscript examples/hellotriangle.lms
# Filament runs on its noop backend here, so the scene is built and "rendered" without pixels.
out = ARGV.len() > 0 ? ARGV[0] : "build/hellotriangle.dslb";
mkdir("build");
mkdir("build/materials");
p = _dsl_ cli="lmfilament" install="github:lmctl-ai/lmfilament@latest";
let mat = fil.material_file("third_party/filament/samples/materials/bakedColor.mat");
let s = fil.scene();
s.skybox(0.1, 0.125, 0.25);
s.camera(45.0, 0.0, 0.0, 3.0, 0.0, 0.0, 0.0);
s.add(fil.triangle(), mat);
s.render_frames(2);
end _dsl_
savedsl(p, out);
r = system(concat(dsl_cli(p), ["--dsl", out]), 900000);
if (r.code != 0) { println(r.stderr + r.stdout); }
assert(r.code == 0);
println("ok hellotriangle");
