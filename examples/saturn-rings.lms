# Saturn and its main rings to scale, in units of the equatorial radius (60,268 km). The planet is oblate (polar/equatorial = 0.902).
# Ring edges: C ring 1.239-1.527, B ring 1.527-1.951, Cassini Division 1.951-2.027, A ring 2.027-2.269 with the Encke gap at 2.214.
# We look from 16 degrees above the ring plane; the Sun is 17 degrees above it on the left. Ported from lmblender examples/saturn-rings.lms
# (no planet shadow on the rings here: the renderer casts no shadows).
out = ARGV.len() > 0 ? ARGV[0] : "build/saturn-rings.dslb";
mkdir("images");
mkdir("build");
p = _lmcode_ cli="lmfilament" install="github:lmctl-ai/lmfilament@latest";
let mat = fil.material("aiDefaultMat", "material {\n    name : AssimpDefaultMat,\n    shadingModel : lit,\n    parameters : [\n        {\n            type : float3,\n            name : baseColor\n        },\n        {\n            type : float,\n            name : metallic\n        },\n        {\n            type : float,\n            name : roughness\n        },\n        {\n            type : float,\n            name : reflectance\n        }\n    ],\n}\n\nfragment {\n    void material(inout MaterialInputs material) {\n        prepareMaterial(material);\n        material.baseColor.rgb = materialParams.baseColor;\n        material.metallic = materialParams.metallic;\n        material.roughness = materialParams.roughness;\n        material.reflectance = materialParams.reflectance;\n    }\n}\n");
mat.set_float("metallic", 0.0);
mat.set_float("roughness", 0.8);
let s = fil.scene();
s.skybox(0.0, 0.0, 0.0);
mat.set_float3("baseColor", 0.82, 0.68, 0.46);
s.add_part(fil.sphere(1.0, 64), mat).scale(1.0, 0.902, 1.0);
mat.set_float3("baseColor", 0.28, 0.26, 0.224);
s.add(fil.ring(1.239, 1.527, 96), mat);
mat.set_float3("baseColor", 0.85, 0.79, 0.68);
s.add(fil.ring(1.527, 1.951, 96), mat);
mat.set_float3("baseColor", 0.62, 0.577, 0.496);
s.add(fil.ring(2.027, 2.202, 96), mat);
mat.set_float3("baseColor", 0.62, 0.577, 0.496);
s.add(fil.ring(2.226, 2.269, 96), mat);
s.directional_light(1.0, 1.0, 1.0, 110000.0, 0.86, -0.29, -0.42);
s.camera(25.0, -1.6, 2.6, 9.0, 0.0, -0.1, 0.0);
s.render_frames(2);
s.render_png("images/saturn-rings.png", 900, 560);
end _lmcode_
savedsl(p, out);
r = system(concat(dsl_cli(p), ["--lmcode", out]), 900000);
if (r.code != 0) { println(r.stderr + r.stdout); }
assert(r.code == 0);
println("ok saturn-rings");
