# Caffeine (1,3,7-trimethylxanthine, C8H10N4O2) as a ball-and-stick model in CPK colours: grey carbon, blue nitrogen, red oxygen, white hydrogen.
# 24 atoms and 29 stick segments (a double bond is two), coordinates copied from the lmblender example caffeine-molecule (one scene unit is one angstrom).
# Ported from lmblender examples/caffeine-molecule.lms.
out = ARGV.len() > 0 ? ARGV[0] : "build/caffeine-molecule.dslb";
mkdir("images");
mkdir("build");
p = _lmcode_ cli="lmfilament" install="github:lmctl-ai/lmfilament@latest";
let mat = fil.material("aiDefaultMat", "material {\n    name : AssimpDefaultMat,\n    shadingModel : lit,\n    parameters : [\n        {\n            type : float3,\n            name : baseColor\n        },\n        {\n            type : float,\n            name : metallic\n        },\n        {\n            type : float,\n            name : roughness\n        },\n        {\n            type : float,\n            name : reflectance\n        }\n    ],\n}\n\nfragment {\n    void material(inout MaterialInputs material) {\n        prepareMaterial(material);\n        material.baseColor.rgb = materialParams.baseColor;\n        material.metallic = materialParams.metallic;\n        material.roughness = materialParams.roughness;\n        material.reflectance = materialParams.reflectance;\n    }\n}\n");
mat.set_float("metallic", 0.0);
mat.set_float("roughness", 0.35);
let s = fil.scene();
s.skybox(0.035, 0.045, 0.07);
mat.set_float3("baseColor", 0.16, 0.17, 0.19);
s.add_at(fil.sphere(0.38, 32), mat, -1.797, 2.0, 0.655);
s.add_at(fil.sphere(0.38, 32), mat, 0.611, 2.0, 0.655);
s.add_at(fil.sphere(0.38, 32), mat, 0.611, 2.0, -0.735);
s.add_at(fil.sphere(0.38, 32), mat, -0.593, 2.0, -1.43);
s.add_at(fil.sphere(0.38, 32), mat, 2.75, 2.0, -0.04);
s.add_at(fil.sphere(0.38, 32), mat, -3.07, 2.0, -1.47);
s.add_at(fil.sphere(0.38, 32), mat, -0.593, 2.0, 2.82);
s.add_at(fil.sphere(0.38, 32), mat, 2.387, 2.0, -2.563);
mat.set_float3("baseColor", 0.1, 0.25, 0.85);
s.add_at(fil.sphere(0.36, 32), mat, -1.797, 2.0, -0.735);
s.add_at(fil.sphere(0.36, 32), mat, -0.593, 2.0, 1.35);
s.add_at(fil.sphere(0.36, 32), mat, 1.933, 2.0, -1.165);
s.add_at(fil.sphere(0.36, 32), mat, 1.933, 2.0, 1.084);
mat.set_float3("baseColor", 0.85, 0.07, 0.05);
s.add_at(fil.sphere(0.36, 32), mat, -2.862, 2.0, 1.27);
s.add_at(fil.sphere(0.36, 32), mat, -0.593, 2.0, -2.66);
mat.set_float3("baseColor", 0.92, 0.92, 0.9);
s.add_at(fil.sphere(0.24, 32), mat, 3.83, 2.0, -0.04);
s.add_at(fil.sphere(0.24, 32), mat, -3.385, 3.028, -1.652);
s.add_at(fil.sphere(0.24, 32), mat, -2.94, 1.486, -2.423);
s.add_at(fil.sphere(0.24, 32), mat, -3.83, 1.486, -0.881);
s.add_at(fil.sphere(0.24, 32), mat, -0.593, 3.028, 3.184);
s.add_at(fil.sphere(0.24, 32), mat, -1.483, 1.486, 3.184);
s.add_at(fil.sphere(0.24, 32), mat, 0.297, 1.486, 3.184);
s.add_at(fil.sphere(0.24, 32), mat, 2.5, 3.028, -2.909);
s.add_at(fil.sphere(0.24, 32), mat, 3.346, 1.486, -2.634);
s.add_at(fil.sphere(0.24, 32), mat, 1.653, 1.486, -3.184);
mat.set_float3("baseColor", 0.62, 0.62, 0.64);
s.add(fil.tube_between(-1.797, 2.0, -0.735, -1.797, 2.0, 0.655, 0.11), mat);
s.add(fil.tube_between(-1.797, 2.0, 0.655, -0.593, 2.0, 1.35, 0.11), mat);
s.add(fil.tube_between(-0.593, 2.0, 1.35, 0.611, 2.0, 0.655, 0.11), mat);
s.add(fil.tube_between(0.611, 2.0, -0.735, -0.593, 2.0, -1.43, 0.11), mat);
s.add(fil.tube_between(-0.593, 2.0, -1.43, -1.797, 2.0, -0.735, 0.11), mat);
s.add(fil.tube_between(0.611, 2.0, -0.735, 1.933, 2.0, -1.165, 0.11), mat);
s.add(fil.tube_between(1.933, 2.0, -1.165, 2.75, 2.0, -0.04, 0.11), mat);
s.add(fil.tube_between(1.933, 2.0, 1.084, 0.611, 2.0, 0.655, 0.11), mat);
s.add(fil.tube_between(-1.732, 2.0, 0.768, -2.797, 2.0, 1.383, 0.075), mat);
s.add(fil.tube_between(-1.862, 2.0, 0.542, -2.927, 2.0, 1.157, 0.075), mat);
s.add(fil.tube_between(-0.723, 2.0, -1.43, -0.723, 2.0, -2.66, 0.075), mat);
s.add(fil.tube_between(-0.463, 2.0, -1.43, -0.463, 2.0, -2.66, 0.075), mat);
s.add(fil.tube_between(-1.797, 2.0, -0.735, -3.07, 2.0, -1.47, 0.11), mat);
s.add(fil.tube_between(-0.593, 2.0, 1.35, -0.593, 2.0, 2.82, 0.11), mat);
s.add(fil.tube_between(1.933, 2.0, -1.165, 2.387, 2.0, -2.563, 0.11), mat);
s.add(fil.tube_between(2.75, 2.0, -0.04, 3.83, 2.0, -0.04, 0.11), mat);
s.add(fil.tube_between(2.855, 2.0, 0.036, 2.038, 2.0, 1.161, 0.075), mat);
s.add(fil.tube_between(2.645, 2.0, -0.116, 1.828, 2.0, 1.008, 0.075), mat);
s.add(fil.tube_between(0.481, 2.0, 0.655, 0.481, 2.0, -0.735, 0.075), mat);
s.add(fil.tube_between(0.741, 2.0, 0.655, 0.741, 2.0, -0.735, 0.075), mat);
s.add(fil.tube_between(-3.07, 2.0, -1.47, -3.385, 3.028, -1.652, 0.11), mat);
s.add(fil.tube_between(-3.07, 2.0, -1.47, -2.94, 1.486, -2.423, 0.11), mat);
s.add(fil.tube_between(-3.07, 2.0, -1.47, -3.83, 1.486, -0.881, 0.11), mat);
s.add(fil.tube_between(-0.593, 2.0, 2.82, -0.593, 3.028, 3.184, 0.11), mat);
s.add(fil.tube_between(-0.593, 2.0, 2.82, -1.483, 1.486, 3.184, 0.11), mat);
s.add(fil.tube_between(-0.593, 2.0, 2.82, 0.297, 1.486, 3.184, 0.11), mat);
s.add(fil.tube_between(2.387, 2.0, -2.563, 2.5, 3.028, -2.909, 0.11), mat);
s.add(fil.tube_between(2.387, 2.0, -2.563, 3.346, 1.486, -2.634, 0.11), mat);
s.add(fil.tube_between(2.387, 2.0, -2.563, 1.653, 1.486, -3.184, 0.11), mat);
s.directional_light(1.0, 1.0, 1.0, 110000.0, -0.45, -0.8, -0.5);
s.camera(40.0, 0.6, 9.0, 9.5, 0.3, 1.8, 0.2);
s.render_frames(2);
s.render_png("images/caffeine-molecule.png", 900, 600);
end _lmcode_
savedsl(p, out);
r = system(concat(dsl_cli(p), ["--dsl", out]), 900000);
if (r.code != 0) { println(r.stderr + r.stdout); }
assert(r.code == 0);
println("ok caffeine-molecule");
