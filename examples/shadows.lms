# Magnum example "Shadows" (https://magnum.graphics/doc/magnum/examples-shadows.html), reproduced headless: a floor and four solids under one directional light with a shadow map. Shadows come from lmfilament's preview rasterizer (`scene.shadows(true)`: an orthographic depth pass along the light, 2048 x 2048, 3 x 3 PCF); Filament's own cascaded shadow maps need a GPU.
out = ARGV.len() > 0 ? ARGV[0] : "build/shadows.dslb";
mkdir("images");
mkdir("build");
p = _lmcode_ cli="lmfilament" install="github:lmctl-ai/lmfilament@latest";
let mat = fil.material("aiDefaultMat", "material {\n    name : AssimpDefaultMat,\n    shadingModel : lit,\n    parameters : [\n        {\n            type : float3,\n            name : baseColor\n        },\n        {\n            type : float,\n            name : metallic\n        },\n        {\n            type : float,\n            name : roughness\n        },\n        {\n            type : float,\n            name : reflectance\n        }\n    ],\n}\n\nfragment {\n    void material(inout MaterialInputs material) {\n        prepareMaterial(material);\n        material.baseColor.rgb = materialParams.baseColor;\n        material.metallic = materialParams.metallic;\n        material.roughness = materialParams.roughness;\n        material.reflectance = materialParams.reflectance;\n    }\n}\n");
mat.set_float("metallic", 0.0);
mat.set_float("roughness", 0.6);
let s = fil.scene();
s.skybox(0.55, 0.7, 0.9);
mat.set_float3("baseColor", 0.75, 0.75, 0.72);
s.add_at(fil.plane(14.0, 14.0), mat, 0.0, -1.0, 0.0);
mat.set_float3("baseColor", 0.85, 0.3, 0.25);
s.add_at(fil.sphere(1.0, 48), mat, -2.8, 0.0, 0.0);
mat.set_float3("baseColor", 0.25, 0.6, 0.85);
s.add_part(fil.box(1.8, 1.8, 1.8), mat).translate(-0.4, -0.1, 0.8).rotate(0.0, 25.0, 0.0);
mat.set_float3("baseColor", 0.9, 0.75, 0.25);
s.add_at(fil.cylinder(0.7, 2.6, 48), mat, 1.9, 0.3, -0.6);
mat.set_float3("baseColor", 0.4, 0.8, 0.45);
s.add_at(fil.cone(0.9, 2.2, 48), mat, 3.6, 0.1, 1.0);
s.shadows(true);
s.directional_light(1.0, 1.0, 1.0, 110000.0, 0.6, -0.55, -0.45);
s.camera(38.0, 0.0, 4.5, 9.5, 0.0, -0.3, 0.0);
s.render_frames(1);
s.render_png("images/shadows.png", 900, 560);
end _lmcode_
savedsl(p, out);
r = system(concat(dsl_cli(p), ["--lmcode", out]), 900000);
if (r.code != 0) { println(r.stderr + r.stdout); }
assert(r.code == 0);
println("ok shadows");
