# Magnum example "Multi Draw" (https://magnum.graphics/doc/magnum/examples-multidraw.html), reproduced headless: 180 meshes of four kinds (box, sphere, cylinder, cone) in six rings, coloured by angle. The original issues them in one GPU multi-draw call; here each is its own shape.
out = ARGV.len() > 0 ? ARGV[0] : "build/multidraw.dslb";
mkdir("images");
mkdir("build");
p = _dsl_ cli="lmfilament" install="github:lmctl-ai/lmfilament@latest";
let mat = fil.material("aiDefaultMat", "material {\n    name : AssimpDefaultMat,\n    shadingModel : lit,\n    parameters : [\n        {\n            type : float3,\n            name : baseColor\n        },\n        {\n            type : float,\n            name : metallic\n        },\n        {\n            type : float,\n            name : roughness\n        },\n        {\n            type : float,\n            name : reflectance\n        }\n    ],\n}\n\nfragment {\n    void material(inout MaterialInputs material) {\n        prepareMaterial(material);\n        material.baseColor.rgb = materialParams.baseColor;\n        material.metallic = materialParams.metallic;\n        material.roughness = materialParams.roughness;\n        material.reflectance = materialParams.reflectance;\n    }\n}\n");
mat.set_float("metallic", 0.0);
mat.set_float("roughness", 0.5);
let s = fil.scene();
s.skybox(0.06, 0.07, 0.1);
for (i in range(0, 180)) {
  let ring = i / 30;
  let k = i - ring * 30;
  let a = float(k) * 6.2831853 / 30.0 + float(ring) * 0.35;
  let rad = 2.0 + 1.25 * float(ring);
  let x = rad * cos(a);
  let z = rad * sin(a);
  let y = 0.45 * sin(3.0 * a + float(ring));
  let kind = i - (i / 4) * 4;
  let cr = 0.5 + 0.5 * sin(a);
  let cg = 0.5 + 0.5 * sin(a + 2.094);
  let cb = 0.5 + 0.5 * sin(a + 4.189);
  mat.set_float3("baseColor", cr, cg, cb);
  if (kind == 0) { s.add_part(fil.box(0.6, 0.6, 0.6), mat).translate(x, y, z).rotate(0.0, a * 57.2958, 0.0); }
  if (kind == 1) { s.add_at(fil.sphere(0.36, 16), mat, x, y, z); }
  if (kind == 2) { s.add_at(fil.cylinder(0.3, 0.7, 24), mat, x, y, z); }
  if (kind == 3) { s.add_at(fil.cone(0.36, 0.7, 24), mat, x, y, z); }
}
s.directional_light(1.0, 1.0, 1.0, 110000.0, -0.4, -0.8, -0.5);
s.camera(42.0, 0.0, 13.0, 16.0, 0.0, 0.0, 0.0);
s.render_frames(1);
s.render_png("images/multidraw.png", 900, 640);
end _dsl_
savedsl(p, out);
r = system(concat(dsl_cli(p), ["--dsl", out]), 900000);
if (r.code != 0) { println(r.stderr + r.stdout); }
assert(r.code == 0);
println("ok multidraw");
