# lmfilament port of upstream samples/texturedquad.cpp
# A quad with the bakedTexture material. The albedo texture parameter is not in the schema yet.
# Run from the repo root (asset paths are relative): lmscript examples/texturedquad.lms
# Filament runs on its noop backend here, so the scene is built and "rendered" without pixels.
out = ARGV.len() > 0 ? ARGV[0] : "build/texturedquad.dslb";
mkdir("build");
mkdir("build/materials");
p = _dsl_ cli="lmfilament" install="github:lmctl-ai/lmfilament@latest";
let mat = fil.material_file("third_party/filament/samples/materials/bakedTexture.mat");
let s = fil.scene();
s.skybox(0.1, 0.125, 0.25);
s.add(fil.plane(2.0, 2.0), mat);
s.camera(45.0, 0.0, 2.0, 2.0, 0.0, 0.0, 0.0);
s.render_frames(1);
end _dsl_
savedsl(p, out);
r = system(concat(dsl_cli(p), ["--dsl", out]), 900000);
if (r.code != 0) { println(r.stderr + r.stdout); }
assert(r.code == 0);
println("ok texturedquad");
